# Server configuration
HOST=0.0.0.0
PORT=8000

# Authentication
SECRET_KEY=change-this-secret-key-in-production-use-a-random-value
TOKEN_EXPIRATION_MINUTES=60

# SQL Server (Windows Authentication)
DB_SERVER=localhost
DB_NAME=LegalRentAI
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_TRUSTED_CONNECTION=true

# SQL Server (SQL Authentication — set DB_TRUSTED_CONNECTION=false)
# DB_USER=sa
# DB_PASSWORD=your-password

# LLM provider: openai (default), anthropic, heuristic, azure, local
LLM_PROVIDER=openai

# Legal CAG corpus (injected into every analysis/chat LLM system prompt)
LEGAL_CAG_ENABLED=true
LEGAL_CAG_CORPUS_PATH=docs/legal-sources/cag-corpus-v1.md

# OpenAI (required when LLM_PROVIDER=openai)
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# Anthropic (required when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Offline LLM evals (python -m evals; separate from production storage/llm-runs)
# EVAL_JUDGE_PROVIDER=openai
# EVAL_JUDGE_OPENAI_MODEL=gpt-4o
# EVAL_JUDGE_ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Reports
REPORTS_STORAGE_DIR=storage/reports

# Frontend (signing schedule links in coordination emails)
FRONTEND_BASE_URL=http://localhost:3000

# Azure Communication Services (signing coordination emails; dev mode logs when empty)
# Recursos ACS pueden estar en otro RG (ej. Dev-Kanbanboard-app); despliegue app en lidr.
# Referencia local: secrets/azure.local.env (gitignored)
AZURE_COMMUNICATION_CONNECTION_STRING=
AZURE_COMMUNICATION_SENDER_ADDRESS=DoNotReply@legalrentai.local
# AZURE_RESOURCE_GROUP_ACS=Dev-Kanbanboard-app
# AZURE_RESOURCE_GROUP_DEPLOY=lidr

# Signing schedule slots (Mon–Fri, America/Mexico_City)
SIGNING_SCHEDULE_SLOT_MINUTES=45
SIGNING_SCHEDULE_WEEKS_AHEAD=4
SIGNING_SCHEDULE_DAYS_AHEAD=30

# Notifications (dev mode logs email when SMTP_HOST is empty)
NOTIFICATION_DEV_MODE=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@legalrentai.local

# Azure OpenAI (when LLM_PROVIDER=azure)
# AZURE_OPENAI_ENDPOINT=your-azure-openai-endpoint
# AZURE_OPENAI_API_KEY=your-azure-openai-api-key
# AZURE_OPENAI_DEPLOYMENT=your-deployment-name
# AZURE_OPENAI_API_VERSION=2024-02-15-preview
