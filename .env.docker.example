# Copy to .env.docker and fill secrets (gitignored via .env.* pattern if configured).
# Compose loads this file per service (not for ${VAR} interpolation in docker-compose.yml).

# SQL Server (local Docker only). Must meet MSSQL complexity rules.
MSSQL_SA_PASSWORD=ChangeMe_Str0ng!Pass
DB_USER=sa
DB_PASSWORD=ChangeMe_Str0ng!Pass

# Public URL of the SPA (signing emails, schedule links)
FRONTEND_BASE_URL=http://localhost:8080

# Auth
SECRET_KEY=change-this-secret-key-in-production-use-a-random-value
TOKEN_EXPIRATION_MINUTES=60

# LLM (required for analysis/chat) — openai | anthropic | heuristic | azure | local
LLM_PROVIDER=openai
# Set here OR in repo .env (api service loads .env after this file; .env wins)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Legal CAG (markdown corpus baked into API image)
LEGAL_CAG_ENABLED=true
LEGAL_CAG_CORPUS_PATH=docs/legal-sources/cag-corpus-v1.md
GUARDRAILS_ENABLED=true

# Document processing (OCR is stub in MVP; keep false in Docker)
OCR_ENABLED=false

# Notifications (log-only in dev)
NOTIFICATION_DEV_MODE=true

# Azure Communication Services (optional)
AZURE_COMMUNICATION_CONNECTION_STRING=
AZURE_COMMUNICATION_SENDER_ADDRESS=DoNotReply@legalrentai.local
